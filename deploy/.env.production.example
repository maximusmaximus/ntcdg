# Copy to /etc/ntcdg/ntcdg.env (chmod 600, owned by root:ntcdg)
# Generate a fresh secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

NTCDG_WEB_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48
NTCDG_PUBLIC_BASE_URL=https://decks.grok.me
# Optional per-deck subdomain mode (requires *.decks.grok.me DNS + wildcard TLS):
# NTCDG_PUBLIC_BASE_URL=https://{deck}.decks.grok.me

NTCDG_COOKIE_SECURE=1
NTCDG_WEB_DB=/var/lib/ntcdg/web.sqlite3
NTCDG_JOB_WORKERS=4
NTCDG_MAX_JOBS_PER_USER=3
NTCDG_MAX_UPLOAD_MB=20
NTCDG_WEB_HOST=127.0.0.1
NTCDG_WEB_PORT=8000
